# Example environment configuration for StudyConnect.
#
# Setup:
#   1. Copy this file to .env.local (same folder). `.env*` files are
#      git-ignored, so your secrets never get committed.
#   2. Fill in real values using docs/TECH_DECISIONS.md as the guide.
# Never commit .env.local or paste real secrets into this file.

# MongoDB Atlas connection string (Database > Connect > Drivers).
# Example shape: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_URI=

# Database name (optional; defaults to "studyconnect" when unset).
MONGODB_DB=studyconnect

# Auth.js session-signing secret. Generate one with:
#   npx auth secret        (writes it to .env.local for you)
# or: openssl rand -base64 32
AUTH_SECRET=

# Tells Auth.js to trust the Host header. Required when running
# `next start` locally. Vercel deployments set this automatically.
AUTH_TRUST_HOST=true

# Vercel Blob read-write token for material uploads (issue #4).
# Create it under Vercel > Storage > Blob. Not needed until file
# uploads are implemented.
BLOB_READ_WRITE_TOKEN=
